# Copy to .env.local; shell variables take precedence. Keep secrets out of Git.
# Quote values containing # so they are not parsed as comments.
INFLUENCE_MAP_ADMIN_TOKEN=
INFLUENCE_MAP_DEV_TOOLS=0
HOST=127.0.0.1
PORT=3000
INFLUENCE_MAP_DB_FILE=./data/influence-map.sqlite
INFLUENCE_MAP_DATA_FILE=./data/graph.json
INFLUENCE_MAP_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REASONING=none
OPENROUTER_JSON_MODE=1
INFLUENCE_MAP_LLM_CONCURRENCY=1
INFLUENCE_MAP_LLM_MAX_QUEUE=8
INFLUENCE_MAP_LLM_TIMEOUT_MS=45000
INFLUENCE_MAP_LLM_MAX_TOKENS=2048
INFLUENCE_MAP_LLM_DAILY_REQUESTS=100
INFLUENCE_MAP_LLM_DAILY_TOKENS=100000
INFLUENCE_MAP_MUTATIONS_PER_MINUTE=30
INFLUENCE_MAP_IDENTITY_AUTO_APPROVE=0
# Optional currency reservation cap; set conservative model rates to enable it.
INFLUENCE_MAP_LLM_DAILY_USD=0
INFLUENCE_MAP_LLM_INPUT_USD_PER_MILLION=0
INFLUENCE_MAP_LLM_OUTPUT_USD_PER_MILLION=0
